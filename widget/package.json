{
  "name": "@codebar-ag/feedback-widget",
  "version": "1.0.0",
  "description": "Self-hosted feedback widget: full-page screenshots with annotations, diagnostics and drafts. Vanilla TypeScript, Shadow DOM, no runtime dependencies in the core.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codebar-ag/feedback.git",
    "directory": "widget"
  },
  "homepage": "https://github.com/codebar-ag/feedback#widget",
  "bugs": {
    "url": "https://github.com/codebar-ag/feedback/issues"
  },
  "author": "codebar Solutions AG <info@codebar.ch>",
  "keywords": [
    "feedback",
    "feedback-widget",
    "bug-report",
    "screenshot",
    "annotation",
    "user-feedback",
    "laravel",
    "typescript",
    "shadow-dom"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/feedback.js",
  "module": "./dist/feedback.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/feedback.iife.js",
  "jsdelivr": "./dist/feedback.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/feedback.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "npm run build && node --experimental-strip-types tests/e2e/server.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../e2e/tsconfig.json",
    "lint": "eslint . && prettier --check . \"../e2e/*.{ts,json}\" \"../e2e/fixtures/**\"",
    "format": "prettier --write . \"../e2e/*.{ts,json}\" \"../e2e/fixtures/**\" && eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile esm-only",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size && npm run publint && npm run attw",
    "e2e": "playwright test -c playwright.config.ts",
    "e2e:full": "NODE_PATH=$PWD/node_modules playwright test -c ../e2e/playwright.config.ts",
    "publish:api": "node scripts/publish-api.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.2.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "size-limit": "14.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "modern-screenshot": "4.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
