{
  "name": "@codebar/feedback-widget",
  "version": "1.0.0",
  "description": "codebar Feedback widget: launcher, form, full page screenshot with annotations and diagnostics.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codebar-ag/feedback.git",
    "directory": "widget"
  },
  "homepage": "https://github.com/codebar-ag/feedback/blob/main/docs/widget-setup.md",
  "keywords": [
    "feedback",
    "widget",
    "screenshot",
    "annotation"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/feedback.js",
  "module": "./dist/feedback.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/feedback.iife.js",
  "jsdelivr": "./dist/feedback.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/feedback.js"
    },
    "./iife": "./dist/feedback.iife.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile esm-only",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size && npm run publint && npm run attw",
    "e2e": "playwright test -c playwright.config.ts",
    "e2e:full": "playwright test -c ../e2e/playwright.config.ts",
    "publish:api": "node scripts/publish-api.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.2.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "size-limit": "14.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "modern-screenshot": "4.7.0"
  }
}
