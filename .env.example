APP_NAME="codebar Feedback"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# sqlite (local), mysql/mariadb or pgsql
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=feedback
# DB_USERNAME=feedback
# DB_PASSWORD=

# Rate limiting uses the cache store.
CACHE_STORE=file

# Comma separated proxy IPs/CIDRs (load balancer, CDN). Empty = trust none.
TRUSTED_PROXIES=

# Base URL of this API as used by the widget (placeholder, see README).
FEEDBACK_ENDPOINT="${APP_URL}"

# full | anonymized
FEEDBACK_IP_MODE=full

# none (off) | cloudflare | maxmind
FEEDBACK_GEO=none
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=
# FEEDBACK_GEOIP_PATH=

# black | white | #RRGGBB, used when a project has no color
FEEDBACK_DEFAULT_COLOR=black

# Rate limits and minimum fill time: no defaults, empty = disabled.
FEEDBACK_LIMIT_PER_IP_PER_MINUTE=
FEEDBACK_LIMIT_PER_PROJECT_PER_MINUTE=
FEEDBACK_MIN_ELAPSED_MS=
